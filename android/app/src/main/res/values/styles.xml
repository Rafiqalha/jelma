<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema jendela saat proses aplikasi dimulai: menampilkan splash sampai Flutter menggambar frame pertama. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema setelah proses berjalan; warnanya sama dengan latar aplikasi Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/latar_aplikasi</item>
    </style>
</resources>
